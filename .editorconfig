# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# 2 space indentation for JavaScript/TypeScript
[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}]
indent_style = space
indent_size = 2

# 2 space indentation for JSON/YAML
[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

# 2 space indentation for Markdown
[*.md]
indent_style = space
indent_size = 2

# Tab indentation for Makefile
[Makefile]
indent_style = tab
